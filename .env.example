# Copy to .env and edit. .env is gitignored.

# Image to launch when create_env.sh runs. Built locally by `make demo-image`.
DEMO_IMAGE=devops-sandbox/demo-app:latest

# Internal port the demo app listens on inside its container.
APP_PORT=8080

# Container name of the front-door nginx (must match docker-compose.yml).
NGINX_CONTAINER=sandbox-nginx

# Shared docker network that nginx + every app container join.
SHARED_NET=sandbox-net

# Host port the front-door nginx publishes on. Change to e.g. 8080 if 80 is taken.
NGINX_HOST_PORT=80

# Port the Flask control API listens on.
API_PORT=5000

# Cleanup daemon scan interval (seconds).
CLEANUP_INTERVAL=60

# Health monitor settings.
HEALTH_INTERVAL=30
HEALTH_TIMEOUT=5
HEALTH_FAILURE_THRESHOLD=3
NGINX_HOST=http://localhost
